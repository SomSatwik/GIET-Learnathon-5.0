# HostelGrievance — Example Environment Configuration
# Copy to .env and fill in values. Never commit .env.

# SQLite database file path (default: data/hostel.db)
HOSTEL_DB_PATH=

# Upload storage directory (default: uploads/)
HOSTEL_UPLOADS_DIR=

# API server port (default: 3001)
HOSTEL_API_PORT=3001

# REQUIRED: secret code to authorize warden self-registration
# Use a strong random alphanumeric string (32+ characters)
# Example generation: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
WARDEN_INVITE_CODE=

# Set to 'production' to disable demo seed and enable Secure cookie flag
NODE_ENV=development
