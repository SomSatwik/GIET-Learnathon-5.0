HOSTEL_API_PORT=3001
HOSTEL_DB_PATH=data/hostel.db
HOSTEL_UPLOADS_DIR=uploads

# ── Development seed credentials ─────────────────────────────────────────────
# These are used ONLY when NODE_ENV != production and the database is empty.
# Override them here during development.  NEVER set these in production — the
# server will refuse to seed demo accounts when NODE_ENV=production regardless.
#
# SEED_PASSWORD_AARAV=student123
# SEED_PASSWORD_PRIYA=student123
# SEED_PASSWORD_ROHAN=student123
# SEED_PASSWORD_WARDEN=warden123

# ── Warden self-registration ──────────────────────────────────────────────────
# Set this to enable the POST /api/register/warden endpoint.
# Share this code only with trusted individuals who need warden accounts.
# If unset, the endpoint returns 403 and warden self-registration is disabled.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# WARDEN_INVITE_CODE=change-me-to-a-strong-random-secret

