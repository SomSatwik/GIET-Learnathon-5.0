{
	"compilerOptions": {
		"target": "ES2022",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"verbatimModuleSyntax": false,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"types": ["node"],
		"rootDir": "src/server"
	},
	"include": ["src/server/**/*.ts"],
	"exclude": ["src/server/**/*.test.ts"]
}
